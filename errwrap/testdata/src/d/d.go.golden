package d

import (
	"errors"
	"fmt"
)

func foo() error {
	err := errors.New("bar!")
	err2 := errors.New("bar!")
	return fmt.Errorf("failed with errors %w, %w", err, err2)
}

func bar() error {
	err := errors.New("bar!")
	err2 := errors.New("bar!")
	return fmt.Errorf("failed with errors %w, %w", err, err2) // want `call could wrap the error with error-wrapping directive %w`
}

func baz() error {
	err := errors.New("bar!")
	return fmt.Errorf("failed with errors %w, %w", err, "not an error") // want `Errorf call has %w directive with non-error operand`
}

func qux() error {
	err := errors.New("bar!")
	return fmt.Errorf("failed with errors %w, %w", err) // want `Errorf call needs 2 args but has 1 arg`
}

func quux() error {
	err := errors.New("bar!")
	args := []any{errors.New("bar!")}
	return fmt.Errorf("failed with errors %w, %w", err, args...)
}

func corge() error {
	return fmt.Errorf("failed with error %w", "not an error") // want `Errorf call has %w directive with non-error operand`
}

func grault() error {
	var value any = errors.New("bar!")
	return fmt.Errorf("failed with error %w", value)
}
